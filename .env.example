# ────────────────────────────────────────────────────────────────────────────
# GitHub auth — set either the App pair (recommended) or a personal token
# ────────────────────────────────────────────────────────────────────────────
GITHUB_APP_ID=your_app_id
# path to the private key for your GitHub App (e.g. ./your-app.pem)
GITHUB_APP_PRIVATE_KEY_PATH=./your-app.pem
# personal access token — alternative to a GitHub App; does not support webhook mode
GITHUB_TOKEN=

# ────────────────────────────────────────────────────────────────────────────
# Bot behaviour
# ────────────────────────────────────────────────────────────────────────────
# only needed in polling mode; leave blank for webhook-only
GITHUB_REPO=owner/repo
# comma-separated repos to skip entirely (e.g. owner/repo1,owner/repo2)
IGNORE_REPOS=
# your GitHub App's username — used to parse comment commands
BOT_HANDLE=diffowlbot
# link shown in the review footer
REPO_URL=https://github.com/EOSKILLZ/LocalOwl
# file used to remember which PRs were already reviewed
STATE_FILE=.processed_prs.json
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# where file logs are written
LOG_FILE=localowl.log
# required for webhook mode — generate with: openssl rand -hex 32
WEBHOOK_SECRET=
WEBHOOK_PORT=8090
# POST anonymous usage stats here after each review (leave empty to disable)
STATS_URL=
# enforce review gating — APPROVE/REQUEST_CHANGES/COMMENT by verdict; off = always COMMENT
AUTO_APPROVE=false

# ────────────────────────────────────────────────────────────────────────────
# Local LLM server (any OpenAI-compatible server works)
# ────────────────────────────────────────────────────────────────────────────
LM_STUDIO_BASE_URL=http://localhost:1234/v1
# only set if your local server requires an API key
LM_STUDIO_API_KEY=
# use the exact model ID from GET /v1/models if "local" is rejected (auto-detected)
LM_STUDIO_MODEL=local
LM_STUDIO_MAX_TOKENS=4096
LM_STUDIO_TEMPERATURE=0.3

# ────────────────────────────────────────────────────────────────────────────
# Polling / diff limits
# ────────────────────────────────────────────────────────────────────────────
POLL_INTERVAL=300
SKIP_DRAFT_PRS=true
RECHECK_UPDATED_PRS=true
MAX_DIFF_CHARS=400000
MAX_FILES_IN_DIFF=100
MAX_LINES_PER_FILE=2000
# comma-separated globs of files to skip in every review
IGNORE_FILE_PATTERNS=*.lock,package-lock.json,*.min.js,*.min.css,dist/*,build/*
